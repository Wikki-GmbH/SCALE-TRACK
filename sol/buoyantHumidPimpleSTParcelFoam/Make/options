JULIA_SHARE = $(shell julia -e 'print(joinpath(Sys.BINDIR, Base.DATAROOTDIR, "julia"))')
JULIA_COMPILE_FLAGS = $(shell $(JULIA_SHARE)/julia-config.jl --cflags)
/* wmake runs this file through cpp, so the comments have to be C ones: a
 * line starting with # is read as a preprocessing directive.
 *
 * julia-config.jl puts Julia's private lib directory on the rpath, and ld
 * searches the rpath when resolving a *shared library's own* dependencies.
 * Where OpenFOAM links a library that needs a versioned symbol of a system
 * library Julia also bundles, ld picks Julia's copy and the link fails.
 * Export JULIA_RPATH_LINK in that case, e.g.
 *   export JULIA_RPATH_LINK="-Wl,-rpath-link,/lib/x86_64-linux-gnu"
 * (-rpath-link is searched before -rpath).  Empty and harmless otherwise.
 */
JULIA_LINK_FLAGS = $(JULIA_RPATH_LINK) $(shell $(JULIA_SHARE)/julia-config.jl --ldflags)
JULIA_LIBS = $(shell $(JULIA_SHARE)/julia-config.jl --ldlibs)

EXE_INC = \
    -I$(FOAM_SOLVERS)/compressible/rhoPimpleFoam \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(LIB_SRC)/sampling/lnInclude \
    -I$(LIB_SRC)/transportModels/compressible/lnInclude \
    -I$(LIB_SRC)/thermophysicalModels/basic/lnInclude \
    -I$(LIB_SRC)/thermophysicalModels/radiation/lnInclude \
    -I$(LIB_SRC)/TurbulenceModels/turbulenceModels/lnInclude \
    -I$(LIB_SRC)/TurbulenceModels/compressible/lnInclude \
    -I$(LIB_SRC)/dynamicMesh/lnInclude \
    -I$(LIB_SRC)/dynamicFvMesh/lnInclude \
    -I$(LIB_SRC)/regionFaModels/lnInclude \
    $(JULIA_COMPILE_FLAGS)

EXE_LIBS = \
    -lfiniteVolume \
    -lfvOptions \
    -lmeshTools \
    -lsampling \
    -lcompressibleTransportModels \
    -lfluidThermophysicalModels \
    -lradiationModels \
    -lspecie \
    -lturbulenceModels \
    -lcompressibleTurbulenceModels \
    -lthermoTools \
    -latmosphericModels \
    -ldynamicMesh \
    -ldynamicFvMesh \
    -ltopoChangerFvMesh \
    -lregionFaModels \
    -lfiniteArea \
    $(JULIA_LINK_FLAGS) $(JULIA_LIBS)
